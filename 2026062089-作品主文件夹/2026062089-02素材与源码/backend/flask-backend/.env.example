# ============================================================
#  环境变量模板：复制为 .env 后填入自己的密钥
#     cp .env.example .env
#  切勿把真实密钥提交进仓库。
# ============================================================

# Flask配置
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8083

# 数据库配置
# 说明：当前实现默认使用 SQLite（backend/flask-backend/interview.db，
# 启动时自动建表），下面的 MySQL 配置项目前不会被使用，仅在改用 MySQL 时需要。
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_interview
DB_USER=root
DB_PASSWORD=change-me

# 科大讯飞配置（历史遗留：语音能力现由 Qwen-Omni-Realtime 承担，
# 后端已无讯飞调用代码，保留键位仅为兼容旧 .env）
IFLYTEK_APP_ID=your_iflytek_app_id
IFLYTEK_API_KEY=your_iflytek_api_key
IFLYTEK_API_SECRET=your_iflytek_api_secret
IFLYTEK_RES_ID=your_iflytek_res_id

# 大模型配置（阿里云百炼 DashScope）
LLM_PROVIDER=tongyi
DASHSCOPE_API_KEY=your_dashscope_api_key_here
LLM_API_KEY=your_dashscope_api_key_here

# RAG服务配置（本地向量检索；未准备好 torch/chroma/models 时保持 false 启动更快）
RAG_SERVICE_URL=http://localhost:8083
RAG_TOP_K=5
RAG_ENABLED=false
RAG_MODE=local
CHROMA_DB_PATH=../../chroma_db
EMBEDDING_MODEL_PATH=../../models/bge-large-zh

# 视频聊天配置（基于 Qwen-Omni-Realtime，视频面试主链路）
QWEN_OMNI_API_KEY=your_dashscope_api_key_here
VIDEO_CHAT_API_KEY=your_dashscope_api_key_here
VIDEO_CHAT_MODEL=qwen3.5-omni-plus-realtime
VIDEO_CHAT_REGION=cn
VIDEO_CHAT_VOICE=Ethan
VIDEO_CHAT_ENABLED=true
VIDEO_CHAT_SAMPLE_RATE=16000
VIDEO_CHAT_AUDIO_CHUNK_SIZE=800
VIDEO_CHAT_MAX_IMAGE_SIZE=512000
VIDEO_CHAT_IMAGE_FORMAT=JPEG
VIDEO_CHAT_IMAGE_QUALITY=85
VIDEO_CHAT_FPS=1
